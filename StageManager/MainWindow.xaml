<Window
    x:Class="StageManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:StageManager"
    xmlns:controls="clr-namespace:StageManager.Controls"
    xmlns:conv="clr-namespace:StageManager.Converters"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    mc:Ignorable="d"
    AllowsTransparency="True"
    ShowInTaskbar="False"
    Topmost="False"
    WindowStyle="None"
    Title="MainWindow"
    Height="450"
    Width="240"
    ShowActivated="False"
    Background="Transparent"
    Name="thisWindow">
    <Window.Resources>
        <Style
            x:Key="SceneOpacity"
            TargetType="{x:Type Grid}">
            <!-- Origin 0,0.5: the tray aligns every tile on a shared left edge, so the
                 pop has to grow rightward and downward-from-centre only. A centred
                 origin pushed the left edge out by (scale-1)*width/2 and a hovered
                 tile visibly broke the column. CompositionThumbnail.ComposeTransform
                 mirrors this anchor for the HwndHost surface. -->
            <Setter Property="RenderTransformOrigin" Value="0,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                    To="1.08" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                    To="1.08" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                    To="1" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                    To="1" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <EventTrigger RoutedEvent="UIElement.PreviewMouseLeftButtonDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="0.96" Duration="0:0:0.08">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="0.96" Duration="0:0:0.08">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="UIElement.PreviewMouseLeftButtonUp">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1.08" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="1.08" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <conv:IndexToOffsetMarginConverter x:Key="IndexToOffsetMarginConverter" />
        <conv:IndexToZIndexConverter x:Key="IndexToZIndexConverter" />
    </Window.Resources>
    <StackPanel
        VerticalAlignment="Center">
        <!-- Current virtual desktop name, above its tiles (other desktops are labelled below). -->
        <TextBlock
            Text="{Binding CurrentDesktopName}"
            HorizontalAlignment="Left"
            Margin="24,0,0,10"
            Foreground="#FFFFFFFF"
            FontSize="13"
            FontWeight="Bold">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.9" Color="Black" />
            </TextBlock.Effect>
        </TextBlock>
        <ItemsControl
            Name="scenesControl"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Padding="22, 0, 0, 0"
            ItemsSource="{Binding Scenes}"
            PreviewMouseLeftButtonDown="ScenesControl_PreviewMouseLeftButtonDown"
            MouseMove="ScenesControl_MouseMove"
            PreviewMouseLeftButtonUp="ScenesControl_PreviewMouseLeftButtonUp">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,28"
                        Visibility="{Binding Visibility}"
                        Style="{StaticResource SceneOpacity}"
                        MouseRightButtonUp="SceneTile_RightClick">
                        <i:Interaction.Triggers>
                            <i:EventTrigger
                                EventName="MouseLeftButtonUp">
                                <i:InvokeCommandAction
                                    Command="{Binding SwitchSceneCommand, Mode=OneTime, Source={x:Reference thisWindow}}"
                                    CommandParameter="{Binding .}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <!-- Windows -->
                        <ItemsControl
                            ItemsSource="{Binding Windows}"
                            AlternationCount="1000">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid
                                        Margin="0,0,0,0"></Grid>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- HorizontalAlignment=Left is load-bearing: the panel is a
                                         Grid and these tiles carry an explicit Width, so the WPF
                                         default (Stretch) CENTRES each one in the row. Scenes whose
                                         windows differ in width then get different left edges, and
                                         within a scene the first window no longer lines up with the
                                         other apps. Left pins every tile's left edge to the row
                                         origin; the deliberate 10px-per-index cascade below (see
                                         IndexToOffsetMarginConverter) then offsets from there, so
                                         index 0 sits flush left. -->
                                    <controls:CompositionThumbnail
                                        PreviewHandle="{Binding Handle}"
                                        CornerRadius="8"
                                        HorizontalAlignment="Left"
                                        TopEdgeDegrees="{Binding DataContext.TiltTopDegrees, RelativeSource={RelativeSource AncestorType=Grid, AncestorLevel=2}}"
                                        BottomEdgeDegrees="{Binding DataContext.TiltBottomDegrees, RelativeSource={RelativeSource AncestorType=Grid, AncestorLevel=2}}"
                                        Width="{Binding PreviewWidth}"
                                        Height="{Binding PreviewHeight}"
                                        MirrorScale="{Binding RenderTransform.(ScaleTransform.ScaleX), RelativeSource={RelativeSource AncestorType=Grid, AncestorLevel=2}}"
                                        MirrorOpacity="{Binding Opacity, RelativeSource={RelativeSource AncestorType=Grid, AncestorLevel=2}}"
                                        Margin="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource IndexToOffsetMarginConverter}}"
                                        Panel.ZIndex="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource IndexToZIndexConverter}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Other virtual desktops: divider, desktop name, app icons. Clicking an icon
             activates that window, and Windows switches to its desktop. -->
        <ItemsControl
            Name="otherDesktopsControl"
            HorizontalAlignment="Left"
            Width="190"
            Margin="22,4,0,0"
            ItemsSource="{Binding OtherDesktops}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,14">
                        <Border Height="1" Background="#55FFFFFF" Margin="0,0,0,8" />
                        <TextBlock
                            Text="{Binding Name}"
                            Foreground="#E6FFFFFF"
                            FontSize="12"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            Margin="2,0,0,6">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.9" Color="Black" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="36" Height="36"
                                        Margin="0,0,8,8"
                                        CornerRadius="9"
                                        Background="#59000000"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        ToolTip="{Binding Title}"
                                        Tag="{Binding Handle}"
                                        RenderTransformOrigin="0.5,0.5"
                                        MouseLeftButtonUp="OtherDesktopApp_Click">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.15" Duration="0:0:0.15" />
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.15" Duration="0:0:0.15" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15" />
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <tb:TaskbarIcon
            x:Name="trayIcon"
            Visibility="Visible"
            ToolTipText="Stage Manager"
            IconSource="StageManager.ico"
            MenuActivation="LeftOrRightClick"
            NoLeftClickDelay="True">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu
                    Style="{StaticResource TrayContextMenuStyle}"
                    Opened="ContextMenu_Opened"
                    Closed="ContextMenu_Closed">
                    <MenuItem
                        Style="{StaticResource TrayMenuLabelStyle}"
                        Header="{Binding AppHeaderText}" />
                    <Separator Style="{StaticResource TrayMenuSeparatorStyle}" />
                    <MenuItem
                        Style="{StaticResource TrayMenuItemStyle}"
                        Header="Start with Windows"
                        IsCheckable="True"
                        IsChecked="{Binding StartsWithWindows}" />
                    <MenuItem
                        Style="{StaticResource TrayMenuItemStyle}"
                        Header="Hide desktop icons"
                        IsCheckable="True"
                        IsChecked="{Binding HideDesktopIcons, Mode=TwoWay}" />
                    <MenuItem
                        x:Name="menuClickDesktop"
                        Style="{StaticResource TrayMenuItemStyle}"
                        Header="Click desktop to show desktop"
                        Click="MenuItem_ClickDesktop_Click" />
                    <Separator Style="{StaticResource TrayMenuSeparatorStyle}" />
                    <MenuItem
                        Style="{StaticResource TrayMenuLabelStyle}"
                        Header="Animation speed" />
                    <MenuItem x:Name="menuAnimOff" Style="{StaticResource TrayMenuItemStyle}" Header="Off (instant)" Tag="0" Click="MenuItem_AnimSpeed_Click" />
                    <MenuItem x:Name="menuAnimFast" Style="{StaticResource TrayMenuItemStyle}" Header="Fast" Tag="220" Click="MenuItem_AnimSpeed_Click" />
                    <MenuItem x:Name="menuAnimNormal" Style="{StaticResource TrayMenuItemStyle}" Header="Normal" Tag="380" Click="MenuItem_AnimSpeed_Click" />
                    <MenuItem x:Name="menuAnimSlow" Style="{StaticResource TrayMenuItemStyle}" Header="Slow" Tag="600" Click="MenuItem_AnimSpeed_Click" />
                    <Separator Style="{StaticResource TrayMenuSeparatorStyle}" />
                    <MenuItem
                        Style="{StaticResource TrayMenuLabelStyle}"
                        Header="Recent apps in sidebar" />
                    <MenuItem x:Name="menuScenes3" Style="{StaticResource TrayMenuItemStyle}" Header="3" Tag="3" Click="MenuItem_MaxScenes_Click" />
                    <MenuItem x:Name="menuScenes4" Style="{StaticResource TrayMenuItemStyle}" Header="4" Tag="4" Click="MenuItem_MaxScenes_Click" />
                    <MenuItem x:Name="menuScenes5" Style="{StaticResource TrayMenuItemStyle}" Header="5" Tag="5" Click="MenuItem_MaxScenes_Click" />
                    <MenuItem x:Name="menuScenes6" Style="{StaticResource TrayMenuItemStyle}" Header="6" Tag="6" Click="MenuItem_MaxScenes_Click" />
                    <MenuItem x:Name="menuScenes8" Style="{StaticResource TrayMenuItemStyle}" Header="8" Tag="8" Click="MenuItem_MaxScenes_Click" />
                    <Separator Style="{StaticResource TrayMenuSeparatorStyle}" />
                    <MenuItem
                        Style="{StaticResource TrayMenuItemStyle}"
                        Header="Project page"
                        Click="MenuItem_ProjectPage_Click" />
                    <MenuItem
                        Style="{StaticResource TrayMenuItemStyle}"
                        Header="{Binding UpdateMenuText}"
                        StaysOpenOnClick="True"
                        Click="MenuItem_CheckForUpdates_Click" />
                    <Separator Style="{StaticResource TrayMenuSeparatorStyle}" />
                    <MenuItem
                        Style="{StaticResource TrayMenuItemStyle}"
                        Header="Quit"
                        Click="MenuItem_Quit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </StackPanel>
</Window>
